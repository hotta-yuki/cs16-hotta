# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# OS generated files
.DS_Store
Thumbs.db

# Project specific ignores
.tmp.drivedownload/
.tmp.driveupload/
install-tl.zip
install-tl-20260520/
tmp/
tmp_output/
pic/

# Large documents and archives (keep code only in git ideally)
試験問題/
進捗報告/**/*.pdf
進捗報告/**/*.synctex.gz

# VS Code / Antigravity specific
# NOTE: '.vscode/*' であって '.vscode/' ではない。ディレクトリごと除外すると
#       '!' による再包含が git の仕様上効かないため。
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
# 推奨拡張機能（LaTeX Workshop など）。別の PC で開いたときに導入を促すため共有する
!.vscode/extensions.json

# LLM history artifacts (audit logs should be tracked, but maybe not the raw DB if large)
# scripts/history.db

# Large data files and output directories
Exam/
# data_im/ は 2026-09-17 に data/ へリネーム（下の /data/ を参照）
output/
*output/
*.npz
*.mp4
*.gif
node_modules/

# Notion exports / reference manuscripts (large zips; 2026-09-17)
pastexam/

# 資料/ と text/ は 2026-09-23 に追跡へ変更（それまでは両方とも除外していた）。
# 発表スライド・原稿・輪読資料も履歴に残したいため。第三者の論文・教科書 PDF を
# 含むので、リポジトリが private であることが前提（公開したままだと再配布になる）。
# 下の 1 件だけは 663 MB あり、GitHub の上限 100 MB を超えて push がリポジトリごと
# 失敗するため除外を続ける。実体は Google Drive に置く。
text/seminar_20260722/堀田_夏セミナー2026.pptx
# 上の *.gif は生成アニメ（数十 MB）向けの除外。資料・原稿に貼る図は小さいので戻す。
!資料/**/*.gif
!text/**/*.gif

# LaTeX build artifacts
*.fdb_latexmk
*.fls
*.synctex.gz
*.aux
*.out

# 個人の作業用スクラッチ（研究パイプラインとは無関係）
/tmp.py

# ルート直下の data/ = 旧 data_im/（2026-09-17 にリネーム）。
# 動画・図・生データで計 436 MB、うち 1 件は 100.8 MB の GIF で
# GitHub の上限 (100 MB) を超えるため、旧 data_im/ と同じく追跡しない。
# 注: vscode/simulation/data/ は別物（実験データの正本）で、そちらは追跡している。
/data/

# 実験データは別リポジトリ lab-data で管理する（2026-09-17）。再現に時間がかかるので
# git で履歴を残すが、コードより桁違いに大きいため本体リポジトリには入れない。
# ここに残っているファイルは作業コピー兼 Google Drive のバックアップ。
# 同期は scripts/sync_data_repo.py、理由と手順は AGENTS.md 11章。
vscode/simulation/data/
