output/
*output/
*.npz
*.mp4
*.gif
node_modules/

# Notion exports / reference manuscripts (large zips; 2026-09-17)
text/
pastexam/

# LaTeX build artifacts
*.fdb_latexmk
*.fls
*.synctex.gz
*.aux
*.out

# 個人の作業用スクラッチ（研究パイプラインとは無関係）
/tmp.py

# ルート直下の data/ = 旧 data_im/（2026-09-17 にリネーム）。
# 動画・図・生データで計 436 MB、うち 1 件は 100.8 MB の GIF で
# GitHub の上限 (100 MB) を超えるため、旧 data_im/ と同じく追跡しない。
# 注: vscode/simulation/data/ は別物（実験データの正本）で、そちらは追跡している。
/data/
